# Copia este archivo a .env. Nunca subas .env al repositorio.

# Lago de datos: carpeta local o bucket (s3://lima-rent-mlops).
DATA_URI=data

# OCI Object Storage por su API compatible con S3.
# La clave se crea en OCI: Perfil > Customer Secret Keys.
S3_ENDPOINT_URL=https://<namespace>.compat.objectstorage.us-ashburn-1.oraclecloud.com
S3_REGION=us-ashburn-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# MLflow: SQLite local, o el servidor (http://localhost:5001 con Docker Compose).
MLFLOW_TRACKING_URI=sqlite:///data/mlflow.db

# Scraping (lento a propósito).
SCRAPE_DELAY_SECONDS=4

# Entrenamiento y reglas de reentrenamiento.
OPTUNA_TRIALS=30
PSI_THRESHOLD=0.2
MAPE_THRESHOLD=0.25
MIN_NEW_LISTINGS=30
MIN_IMPROVEMENT=0.01

# Dashboard -> API.
API_URL=http://localhost:8080
